APP_ENV=development
DEMO_WORKSPACE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ENFORCE_RLS_ROLE=true
OUTBOX_WEBHOOK_URL=
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080
DATABASE_URL=postgresql+asyncpg://thesis:thesis@postgres:5432/thesis
TEMPORAL_HOST=temporal:7233
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=thesis
S3_SECRET_KEY=thesissecret
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:3000
INTERNAL_API_URL=http://api:8000
BROWSER_ENABLED=false
# Required before enabling browser research; must enforce SSRF at connection time.
BROWSER_EGRESS_PROXY_URL=
