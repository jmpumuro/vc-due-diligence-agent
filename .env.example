RESEARCH_EXECUTION_BACKEND=local
SANDBOX_ENDPOINT=http://127.0.0.1:8095
SANDBOX_API_KEY=
SANDBOX_IMAGE=
SANDBOX_OWNER=thesis-research
SANDBOX_CONCURRENCY=2
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_CREDENTIALS_FILE=
SETUP_COMPLETE=false
OCR_PRODUCT_VERIFIED=false
